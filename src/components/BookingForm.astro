---
import Eyebrow from './Eyebrow.astro';
---

<div class="form-card bg-surface rounded-[10px] border border-hairline p-[var(--spacing-2xl)] grid grid-cols-1 md:grid-cols-2 gap-[var(--spacing-2xl)]">
  <div>
    <Eyebrow text="Запись" />
    <h2 class="section-title text-[length:var(--text-2xl)] mt-[var(--spacing-s)]">Оставьте заявку</h2>
    <p class="section-desc text-text-body mt-[var(--spacing-s)]">Перезвоним в течение 15 минут, подберём удобное время и ответим на вопросы о процедуре.</p>
  </div>
  <form class="booking-form" id="booking-form">
    <div class="form-body space-y-[var(--spacing-m)]">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-[var(--spacing-m)]">
        <div class="field">
          <label for="bf-name" class="block text-[length:var(--text-s)] font-medium mb-[var(--spacing-3xs)]">Имя</label>
          <input type="text" name="name" id="bf-name" placeholder="Как к вам обращаться" required
            class="form-input w-full bg-canvas border border-hairline rounded px-[var(--spacing-s)] py-[var(--spacing-2xs)] outline-none focus:border-primary transition-colors" />
        </div>
        <div class="field">
          <label for="bf-phone" class="block text-[length:var(--text-s)] font-medium mb-[var(--spacing-3xs)]">Телефон</label>
          <input type="tel" name="phone" id="bf-phone" placeholder="+7 (___) ___-__-__" required
            class="form-input w-full bg-canvas border border-hairline rounded px-[var(--spacing-s)] py-[var(--spacing-2xs)] outline-none focus:border-primary transition-colors" />
        </div>
      </div>
      <div class="field">
        <label for="bf-service" class="block text-[length:var(--text-s)] font-medium mb-[var(--spacing-3xs)]">Услуга</label>
        <select name="service" id="bf-service"
          class="w-full bg-canvas border border-hairline rounded px-[var(--spacing-s)] py-[var(--spacing-2xs)] outline-none focus:border-primary transition-colors">
          <option value="Чистка лица">Чистка лица</option>
          <option value="Уходовые процедуры, массаж лица">Уходовые процедуры, массаж лица</option>
          <option value="Пилинги лица">Пилинги лица</option>
          <option value="Мезотерапия">Мезотерапия</option>
          <option value="Плазмотерапия">Плазмотерапия</option>
          <option value="Ботулинотерапия">Ботулинотерапия</option>
          <option value="Контурная пластика">Контурная пластика</option>
          <option value="Не знаю — нужна консультация">Не знаю — нужна консультация</option>
        </select>
      </div>
      <div class="field">
        <label for="bf-comment" class="block text-[length:var(--text-s)] font-medium mb-[var(--spacing-3xs)]">Комментарий</label>
        <textarea name="comment" id="bf-comment" placeholder="Удобное время, вопросы к врачу" rows="3"
          class="w-full bg-canvas border border-hairline rounded px-[var(--spacing-s)] py-[var(--spacing-2xs)] outline-none focus:border-primary transition-colors resize-y"></textarea>
      </div>
      <button class="btn btn-primary btn-lg" type="submit">Отправить заявку</button>
      <p class="text-[length:var(--text-xs)] text-stone">Нажимая кнопку, вы соглашаетесь с политикой обработки персональных данных.</p>
    </div>
    <div class="form-success hidden" role="status">
      <h3 class="text-[length:var(--text-xl)] font-display text-text-title">Спасибо! Заявка отправлена</h3>
      <p class="mt-[var(--spacing-s)] text-text-body">Администратор студии перезвонит вам в течение 15 минут в рабочие часы: ежедневно с 09:00 до 21:00.</p>
    </div>
  </form>
</div>

<style>
  .form-input.is-invalid {
    border-color: var(--color-error);
  }
</style>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement;
  if (form) {
    const nameField = form.querySelector('[name="name"]') as HTMLInputElement;
    const phoneField = form.querySelector('[name="phone"]') as HTMLInputElement;
    
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let valid = true;
      [nameField, phoneField].forEach(field => {
        if (!field) return;
        const empty = !field.value || field.value.trim().length < 2;
        field.classList.toggle('is-invalid', empty);
        if (empty) valid = false;
      });
      if (!valid) {
        const firstInvalid = form.querySelector('.is-invalid') as HTMLElement;
        firstInvalid?.focus();
        return;
      }
      const body = form.querySelector('.form-body') as HTMLElement;
      const success = form.querySelector('.form-success') as HTMLElement;
      if (body) body.style.display = 'none';
      if (success) {
        success.style.display = 'block';
        success.setAttribute('tabindex', '-1');
        success.focus();
      }
    });
    
    [nameField, phoneField].forEach(field => {
      field?.addEventListener('input', () => {
        field.classList.remove('is-invalid');
      });
    });
  }
</script>
