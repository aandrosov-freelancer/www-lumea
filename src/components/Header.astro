---
---
<header class="site-header sticky top-0 z-90 backdrop-blur-[14px] border-b border-hairline bg-[color-mix(in_srgb,var(--color-canvas)_86%,transparent)]">
  <div class="container flex items-center justify-between py-[var(--spacing-s)]">
    <!-- Brand -->
    <a class="brand flex flex-col" href="/">
      <span class="font-display text-[length:var(--text-xl)] text-text-title uppercase tracking-[0.24em]">Luméa</span>
      <span class="text-[length:var(--text-xs)] text-stone uppercase tracking-[0.3em]">cosmetology studio</span>
    </a>
    <!-- Nav -->
    <nav class="site-nav hidden md:flex items-center gap-[var(--spacing-l)]">
      <a href="/" class="nav-link">Главная</a>
      <a href="/services" class="nav-link">Услуги</a>
      <a href="/contacts" class="nav-link">Контакты</a>
    </nav>
    <!-- Actions -->
    <div class="flex items-center gap-[var(--spacing-m)]">
      <a class="hidden md:inline text-[length:var(--text-s)] text-text-title" href="tel:+78152456789">+7 (8152) 45-67-89</a>
      <a class="hidden xs:inline-flex btn-primary" href="/contacts">Записаться</a>
      <button class="nav-toggle md:hidden" aria-expanded="false" aria-label="Меню" type="button">
        <span></span><span></span>
      </button>
    </div>
  </div>
  
  <div class="mobile-nav md:hidden">
    <a href="/">Главная</a>
    <a href="/services">Услуги</a>
    <a href="/contacts">Контакты</a>
    <a href="tel:+78152456789">+7 (8152) 45-67-89</a>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    font-size: var(--text-s);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-title);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 1px;
    background: var(--color-primary);
    transition: width 0.35s ease;
  }
  .nav-link:hover::after {
    width: 100%;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-text-title);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .site-header.is-open .nav-toggle span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .site-header.is-open .nav-toggle span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  /* Mobile nav drawer */
  .mobile-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-hairline);
    padding: var(--spacing-l);
  }
  .site-header.is-open .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-s);
  }
  .mobile-nav a {
    font-size: var(--text-l);
    font-family: var(--font-display);
    color: var(--color-text-title);
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  if (header && toggle) {
    toggle.addEventListener('click', () => {
      const open = header.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    header.querySelectorAll('.mobile-nav a').forEach(link => {
      link.addEventListener('click', () => {
        header.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
