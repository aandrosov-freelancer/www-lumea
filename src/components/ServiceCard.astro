---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  text: string;
  price: string;
  image: ImageMetadata;
  href?: string;
}

const { name, text, price, image, href } = Astro.props;
---

<a class:list={['svc-card', 'group', 'block']} href={href || '/services'}>
  <span class="svc-media block overflow-hidden rounded-md bg-blush">
    <Image 
      src={image} 
      alt="" 
      class="w-full aspect-[3/4] object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.2,0.7,0.3,1)] group-hover:scale-[1.06]" 
      widths={[320, 640, 736]}
      sizes="(max-width: 375px) 100vw, (max-width: 768px) 50vw, 25vw"
    />
  </span>
  <span class="block font-display text-[length:var(--text-l)] text-text-title mt-[var(--spacing-s)]">{name}</span>
  <span class="block text-[length:var(--text-s)] text-stone mt-[var(--spacing-3xs)]">{text}</span>
  <span class="block text-[length:var(--text-s)] font-medium text-text-title mt-[var(--spacing-2xs)]">{price}</span>
</a>
