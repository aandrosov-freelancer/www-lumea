---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  index: string;      // "01", "02", etc.
  title: string;
  desc: string;
  variants: string[];
  duration: string;
  price: string;
  image: ImageMetadata;
  id: string;
  reverse?: boolean;  // for alternating layout
}

const { index, title, desc, variants, duration, price, image, id, reverse } = Astro.props;
---

<article class="svc-detail" id={id}>
  <div class:list={['grid grid-cols-1 md:grid-cols-2 gap-[var(--spacing-2xl)] items-center', { 'md:[&>.svc-photo]:order-2': reverse }]}>
    <div class="svc-photo">
      <Image src={image} alt="" class="w-full rounded-lg object-cover" widths={[400, 900]} sizes="(max-width: 768px) 100vw, 50vw" />
    </div>
    <div class="svc-info">
      <span class="font-display text-[length:var(--text-l)] text-primary">{index}</span>
      <h2 class="text-[length:var(--text-2xl)] mt-[var(--spacing-2xs)]">{title}</h2>
      <p class="text-text-body mt-[var(--spacing-s)] max-w-[50ch]">{desc}</p>
      <ul class="flex flex-wrap gap-[var(--spacing-2xs)] mt-[var(--spacing-m)]">
        {variants.map(v => <li class="px-3.5 py-1 rounded-full border border-hairline text-[length:var(--text-s)] text-stone">{v}</li>)}
      </ul>
      <div class="flex items-center gap-[var(--spacing-m)] mt-[var(--spacing-m)] text-[length:var(--text-s)] text-stone">
        <span>{duration}</span>
        <span class="font-medium text-text-title">{price}</span>
      </div>
      <a class="btn btn-primary mt-[var(--spacing-m)] inline-flex" href="/contacts">Записаться</a>
    </div>
  </div>
</article>

<style>
  .svc-detail + .svc-detail {
    padding-top: var(--spacing-3xl);
    border-top: 1px solid var(--color-hairline);
    margin-top: var(--spacing-3xl);
  }
</style>
